{
  "name": "claude-mods",
  "private": true,
  "packageManager": "pnpm@12.20.0",
  "scripts": {
    "check": "sh scripts/check.sh && sh scripts/check.test.sh",
    "fix": "prettier --write . && eslint --fix . && pnpm check",
    "mutate": "node scripts/mutate.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
